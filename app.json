{
  "expo": {
    "name": "TC5",
    "slug": "notification-tc5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TC5-3-RAYAS.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "name": "TC5",
      "icon": "./assets/images/TC5-3-RAYAS.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.cticontrol.notificationtc5",
      "buildNumber": "14",
      "googleServicesFile": "./ios/TC5/GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyBdJZTv6ZQfBgLMUrKCXUvnaCGyHTiiV4I"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceder a tu ubicación para guardar la ubicacion de Naves.",
        "NSLocationAlwaysUsageDescription": "Esta app requiere acceso constante a la ubicación para notificaciones.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBdJZTv6ZQfBgLMUrKCXUvnaCGyHTiiV4I"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.santicticontrol.notificationtc5",
      "googleServicesFile": "./android/app/google-services.json",
      "usesCleartextTraffic": true,
      "manifest": {
        "metaData": [
          {
            "android:name": "com.google.firebase.messaging.default_notification_channel_id",
            "android:value": "alarm-channel"
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
     "devBuildNumber": 7,
      "apiUrl": "https://api.tc5monitor.cticontrol.com/api",
      "apiUrlDev": "https://api.tc5monitortest.cticontrol.com/api",
      "socketUrl": "https://api.tc5monitor.cticontrol.com",
      "socketUrlDev": "https://api.tc5monitortest.cticontrol.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ac5a5f62-f7b4-4e22-b614-a8e5abd6f349"
      }
    },
    "owner": ""
  }
}
