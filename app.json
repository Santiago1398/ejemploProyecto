{
  "expo": {
    "name": "TC5",
    "slug": "notification-tc5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TC5-3-RAYAS.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.control.notificationtc5"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBdJZTv6ZQfBgLMUrKCXUvnaCGyHTiiV4I"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/TC5-3-RAYAS.png",
        "backgroundColor": "#000000"
      },
      "package": "com.control.notificationtc5",
      "googleServicesFile": "./android/app/google-services.json",
      "usesCleartextTraffic": true,
      "manifest": {
        "metaData": [
          {
            "android:name": "com.google.firebase.messaging.default_notification_channel_id",
            "android:value": "alarm-channel"
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "devBuildNumber": 21,
      "apiUrl": "https://api.tc5monitor.cticontrol.com/api",
      "apiUrlDev": "https://api.tc5monitortest.cticontrol.com/api",
      "socketUrl": "https://api.tc5monitor.cticontrol.com",
      "socketUrlDev": "https://api.tc5monitortest.cticontrol.com",
      "portalUrl": "https://ctiportal.cticontrol.com/login.xhtml",
      "portalUrlDev": "https://ctiportaltest.cticontrol.com/login.xhtml",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ac5a5f62-f7b4-4e22-b614-a8e5abd6f349"
      }
    }
  }
}